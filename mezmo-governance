#!/bin/sh
# Install, check and try the Mezmo Governance plugins: ./mezmo-governance help
# Runs tools/mezmo_governance_cli.py with the first Python 3.9 or later it finds.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
for python in python3 python3.14 python3.13 python3.12 python3.11 python3.10 python3.9 \
  /opt/homebrew/bin/python3 /usr/local/bin/python3; do
  if command -v "$python" >/dev/null 2>&1 &&
    "$python" -c 'import sys; sys.exit(sys.version_info < (3, 9))' >/dev/null 2>&1; then
    exec "$python" "$here/tools/mezmo_governance_cli.py" "$@"
  fi
done
echo "mezmo-governance needs Python 3.9 or later; on macOS run: brew install python" >&2
exit 1
