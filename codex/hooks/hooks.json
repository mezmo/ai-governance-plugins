{
  "description": "Mezmo Governance: authorize each tool call, then log the result locally. Mezmo ledger: record each call, off until its settings are set",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/mezmo_governance_hook.py\" || { s=$?; [ $s -eq 2 ] || echo 'Mezmo Governance hook failed; blocking' >&2; exit 2; }",
            "timeout": 600,
            "statusMessage": "Checking Mezmo Governance"
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/mezmo_ledger_hook.py\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/mezmo_governance_hook.py\"",
            "timeout": 15,
            "statusMessage": "Recording the governed result"
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/mezmo_ledger_hook.py\" || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
