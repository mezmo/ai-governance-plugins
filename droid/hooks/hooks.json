{
  "PreToolUse": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "command": "python3 \"${DROID_PLUGIN_ROOT}/mezmo_governance_hook.py\" || { s=$?; [ $s -eq 2 ] || echo 'Mezmo Governance hook failed; blocking' >&2; exit 2; }",
          "timeout": 600
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "command": "python3 \"${DROID_PLUGIN_ROOT}/mezmo_governance_hook.py\"",
          "timeout": 15
        }
      ]
    }
  ]
}
