{
  "description": "Mezmo status mod (footer indicator, one connection check per session, /mezmo) and the Mezmo Governance tool-call check, which stays off until an access key is configured",
  "modules": ["./register.ts"],
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/governance_hook.py\"",
            "timeout": 600,
            "onFailure": "block",
            "statusMessage": "Checking Mezmo Governance"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/governance_hook.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/governance_hook.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
