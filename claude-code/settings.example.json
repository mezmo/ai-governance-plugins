{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${MEZMO_GOVERNANCE_HOOK:-$HOME/.claude/hooks/mezmo_governance_hook.py}\"",
            "timeout": 600,
            "onFailure": "block",
            "statusMessage": "Checking Mezmo Governance"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${MEZMO_GOVERNANCE_HOOK:-$HOME/.claude/hooks/mezmo_governance_hook.py}\"",
            "timeout": 15,
            "statusMessage": "Recording the governed result"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${MEZMO_GOVERNANCE_HOOK:-$HOME/.claude/hooks/mezmo_governance_hook.py}\"",
            "timeout": 15,
            "statusMessage": "Recording the governed result"
          }
        ]
      }
    ]
  }
}
